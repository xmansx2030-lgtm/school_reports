# Example environment variables for school_reports
# Copy to .env locally, and set the same keys in production.
# DO NOT commit real secrets.

# -----------------
# Django
# -----------------
ENV=development
DEBUG=True
SECRET_KEY=unsafe-secret

# Comma-separated (no spaces)
ALLOWED_HOSTS=localhost,127.0.0.1
# Public canonical origin used by sitemap.xml and SEO metadata.
# Production example: https://tawtheeq-ksa.com
SITE_URL=http://127.0.0.1:8000
# Redirect legacy public hosts to SITE_URL in production.
CANONICAL_HOST_REDIRECT=False
# Reverse-proxy networks allowed to supply X-Real-IP. Keep this narrow in production.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12

# -----------------
# Public business disclosures
# -----------------
# Shown only inside a collapsed legal disclosure on public pages. Use the exact
# registered values in production; never add a national ID or personal photo.
BUSINESS_LEGAL_NAME=
# Configure either the commercial registration OR the freelance document.
BUSINESS_COMMERCIAL_REGISTRATION=
BUSINESS_FREELANCE_DOCUMENT_NUMBER=
# Exact profession/activity printed on the valid freelance document.
BUSINESS_FREELANCE_ACTIVITY=
# ISO date printed on the document, e.g. 2027-06-26.
BUSINESS_FREELANCE_DOCUMENT_EXPIRY=
# Specific public verification URL when available; otherwise the general
# validation service is used.
BUSINESS_FREELANCE_DOCUMENT_URL=
BUSINESS_TAX_NUMBER=
# Comma-separated license names/numbers, when the activity requires them.
BUSINESS_LICENSES=
# Saudi Business Center verification URL for the e-store, when available.
BUSINESS_VERIFICATION_URL=
BUSINESS_ADDRESS=
BUSINESS_SUPPORT_EMAIL=
BUSINESS_SUPPORT_PHONE=

# -----------------
# WebAuthn / Passkeys (الدخول بالبصمة)
# -----------------
# معرّف نطاق ثابت لمفاتيح البصمة. اضبطه على النطاق الأب في الإنتاج حتى تعمل
# البصمة عبر كل النطاقات الفرعية (apex / www / app). مثال:
# WEBAUTHN_RP_ID=tawtheeq-ksa.com
# اتركه فارغاً محلياً (سيُشتق تلقائياً من المضيف، مثل localhost).
WEBAUTHN_RP_ID=

# Database
# - local dev default uses SQLite if DATABASE_URL is empty
# - Postgres example:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# -----------------
# Redis (Celery broker + optional cache)
# -----------------
# If you don't have Redis in dev, you can leave it empty.
REDIS_URL=
# Optional: separate cache Redis URL
REDIS_CACHE_URL=

# -----------------
# Cloudflare R2 (S3-compatible media storage)
# -----------------
# Required to enable R2:
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=school-reports

# IMPORTANT: endpoint WITHOUT bucket name, e.g.
# https://<accountid>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=

# Uploaded school files are private by default and served with expiring signed
# URLs. Enable public access only after a deliberate privacy review.
MEDIA_PUBLIC_ACCESS_ENABLED=0

# Optional public domain (used only when MEDIA_PUBLIC_ACCESS_ENABLED=1)
R2_PUBLIC_DOMAIN=

# Signed URLs are mandatory while MEDIA_PUBLIC_ACCESS_ENABLED=0.
AWS_QUERYSTRING_AUTH=1

# -----------------
# Optional: security hardening
# -----------------
CSP_ENABLED=0
CSP_REPORT_ONLY=1
# CONTENT_SECURITY_POLICY=default-src 'self'; ...
SECURITY_CONTACT_EMAIL=support@tawtheeq-ksa.com

# -----------------
# Mansour AI assistant (homepage)
# -----------------
# Keep the real key in the server environment only.
OPENAI_API_KEY=
MANSOUR_ASSISTANT_ENABLED=0
MANSOUR_ASSISTANT_MODEL=gpt-5-nano
MANSOUR_ASSISTANT_MAX_OUTPUT_TOKENS=350
MANSOUR_ASSISTANT_TIMEOUT_SECONDS=20
# Platform-wide ceiling on paid assistant calls per day. The per-IP limit
# (50/day) cannot bound the bill on a public widget: a viral launch or a
# distributed scraper simply arrives from many addresses. 0 disables it.
MANSOUR_ASSISTANT_DAILY_GLOBAL_LIMIT=2000
REPORT_AI_ENABLED=0
REPORT_AI_MODEL=gpt-5-nano
REPORT_AI_MAX_OUTPUT_TOKENS=700
REPORT_AI_TIMEOUT_SECONDS=25

# -----------------
# Tamara payments (start with Sandbox)
# -----------------
# Never commit API or notification tokens. Register this HTTPS webhook in Tamara:
# https://your-domain.example/payments/tamara/webhook/
TAMARA_ENABLED=0
TAMARA_ENVIRONMENT=sandbox
TAMARA_API_TOKEN=
TAMARA_NOTIFICATION_TOKEN=
TAMARA_INSTALMENTS=4
TAMARA_REQUEST_TIMEOUT=15

# Moyasar hosted invoices (start with Test; never expose the sk_* key to browsers)
# The per-invoice callback is verified again through Moyasar's API before fulfilment.
MOYASAR_ENABLED=0
MOYASAR_ENVIRONMENT=test
MOYASAR_SECRET_KEY=
MOYASAR_REQUEST_TIMEOUT=15

# -----------------
# Logging
# -----------------
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05

# -----------------
# Production runtime/resource limits
# -----------------
PRODUCTION_STRICT_MODE=True
# Number of gunicorn processes. ASGI already serves requests concurrently
# inside one process, so raise this for CPU parallelism only. Budget ~250 MB
# of RAM per worker, and keep
#   WEB_CONCURRENCY × MAX_CONCURRENT_REQUESTS
# below PostgreSQL max_connections minus Celery workers and beat.
WEB_CONCURRENCY=3
# NOTE: GUNICORN_THREADS is no longer used — the Uvicorn worker ignores
# gunicorn's --threads. Concurrency is bounded by MAX_CONCURRENT_REQUESTS.
GUNICORN_TIMEOUT=120
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=800
GUNICORN_MAX_REQUESTS_JITTER=80
# Load shedding: max requests processed at once per web process. Beyond this,
# visitors get a fast 503 + Retry-After instead of every request timing out.
# 0 disables shedding. Leave it unset to derive it automatically from
#   (DB_MAX_CONNECTIONS - DB_RESERVED_CONNECTIONS) / WEB_CONCURRENCY
# Calibrate against the real host with: python scripts/loadtest.py <url> -h
# MAX_CONCURRENT_REQUESTS=   # unset: derived from the budget below
OVERLOAD_RETRY_AFTER_SECONDS=5
DB_MAX_CONNECTIONS=100
DB_RESERVED_CONNECTIONS=15
# Landing pricing cache. Plan edits clear it immediately; this is the backstop.
LANDING_PRICING_CACHE_TTL_SECONDS=60
SCHOOL_DASHBOARD_CACHE_TTL_SECONDS=45
SCHOOL_DASHBOARD_STALE_TTL_SECONDS=300
SCHOOL_DASHBOARD_LOCK_TTL_SECONDS=15
SCHOOL_RATE_LIMIT_ENABLED=True
SCHOOL_RATE_LIMIT_REQUESTS=900
SCHOOL_RATE_LIMIT_WINDOW_SECONDS=60
HEAVY_EXPORT_ASYNC_ENABLED=True
PDF_OFFLOAD_ENABLED=True
PDF_OFFLOAD_TIMEOUT_SECONDS=45
GENERATED_EXPORT_RETENTION_HOURS=6
# Capacity watch: alerts before Redis eviction or a session backlog bites.
INFRA_CAPACITY_MONITOR_ENABLED=True
REDIS_MEMORY_ALERT_PERCENT=80
EXPIRED_SESSION_ALERT_THRESHOLD=100000
CPU_ALERT_PERCENT=85
MEMORY_ALERT_PERCENT=85
DISK_ALERT_PERCENT=80
CELERY_QUEUE_ALERT_LENGTH=200
HTTP_ALERT_MIN_SAMPLES=20
HTTP_5XX_ALERT_PERCENT=2.0
HTTP_LATENCY_ALERT_MS=2000
# 0 closes the DB connection at the end of each request. Persistent connections
# cannot be reused under ASGI (a new thread per request) and only delay the
# close, so a non-zero value should be set only behind PgBouncer.
CONN_MAX_AGE=0
FILE_UPLOAD_MAX_MEMORY_SIZE=2097152
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
DATA_UPLOAD_MAX_NUMBER_FILES=20
HEALTHZ_CHECK_CHANNELS=0
# Set to 0 on deployments that run more than one web container, so replicas do
# not race each other running migrations at boot.
RUN_MIGRATIONS_ON_START=1
# Redis: volatile-lru evicts only keys with a TTL (cache, sessions, channels)
# and never Celery's queues, so memory pressure degrades the cache instead of
# taking the broker down.
REDIS_MAXMEMORY_POLICY=volatile-lru

# -----------------
# Email (for daily manager reports)
# -----------------
# Dev default in settings is console backend; production default is SMTP.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=no-reply@tawtheeq-ksa.com
# One-time password reset link lifetime in seconds (default: 1 hour).
PASSWORD_RESET_TIMEOUT=3600

# Keep this disabled in production until SMTP and matching DNS
# records (SPF/DKIM/DMARC) are configured for the sending provider.
PASSWORD_CHANGE_EMAIL_ENABLED=0

# -----------------
# Telegram operational alerts
# -----------------
# Keep the token in the real environment only; never commit it.
TELEGRAM_ALERTS_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_ALERT_CATEGORIES=support,subscriptions,registration,payments,complaints
TELEGRAM_ALERT_TIMEOUT_SECONDS=10
TELEGRAM_ALERT_DEDUP_TTL_SECONDS=2592000

# -----------------
# Daily manager report (2:00 PM by default)
# -----------------
DAILY_MANAGER_REPORT_ENABLED=1
DAILY_MANAGER_REPORT_INAPP_ENABLED=1
DAILY_MANAGER_REPORT_EMAIL_ENABLED=0
DAILY_MANAGER_REPORT_WHATSAPP_ENABLED=0
DAILY_MANAGER_REPORT_HOUR=14
DAILY_MANAGER_REPORT_MINUTE=0

# WhatsApp webhook (optional)
# Expected JSON payload with: channel, to, message, school_id, school_name, report_date, metrics
DAILY_MANAGER_REPORT_WHATSAPP_WEBHOOK_URL=
DAILY_MANAGER_REPORT_WHATSAPP_WEBHOOK_TOKEN=
DAILY_MANAGER_REPORT_WHATSAPP_TIMEOUT_SECONDS=10
# تجربة التسجيل الذاتي للمدرسة
TRIAL_DAYS=30
TRIAL_PLAN_NAME=التجربة المجانية
TRIAL_MAX_TEACHERS=5
TRIAL_ARCHIVE_STORAGE_GB=1
