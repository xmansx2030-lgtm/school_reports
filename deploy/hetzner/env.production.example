ENV=production
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret

SITE_URL=https://tawtheeq-ksa.com
CANONICAL_HOST_REDIRECT=True
PWA_INSTALL_ENABLED=True
ALLOWED_HOSTS=app.tawtheeq-ksa.com,tawtheeq-ksa.com,www.tawtheeq-ksa.com
CSRF_TRUSTED_ORIGINS=https://app.tawtheeq-ksa.com,https://tawtheeq-ksa.com,https://www.tawtheeq-ksa.com
WEBAUTHN_RP_ID=tawtheeq-ksa.com
# Generate once with `python manage.py generate_vapid_keys`; keep this pair
# stable across deploys so already-installed devices remain subscribed.
WEB_PUSH_ENABLED=True
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_SUBJECT=mailto:support@tawtheeq-ksa.com
WEB_PUSH_TIMEOUT_SECONDS=10
PRODUCTION_STRICT_MODE=True
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12

# Required public business disclosure. Do not add a national ID or photo.
BUSINESS_LEGAL_NAME=
BUSINESS_COMMERCIAL_REGISTRATION=
BUSINESS_FREELANCE_DOCUMENT_NUMBER=
BUSINESS_FREELANCE_ACTIVITY=
BUSINESS_FREELANCE_DOCUMENT_EXPIRY=
BUSINESS_FREELANCE_DOCUMENT_URL=https://freelance.sa/certificate-validation
BUSINESS_TAX_NUMBER=
BUSINESS_LICENSES=
BUSINESS_VERIFICATION_URL=
BUSINESS_ADDRESS=
BUSINESS_SUPPORT_EMAIL=
BUSINESS_SUPPORT_PHONE=

POSTGRES_DB=school_reports
POSTGRES_USER=school_reports
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://school_reports:replace-with-a-url-encoded-password@postgres:5432/school_reports
DB_SSL=False

REDIS_PASSWORD=replace-with-a-long-random-password
REDIS_URL=redis://:replace-with-a-url-encoded-password@redis:6379/0
REDIS_MAXMEMORY=192mb

# مخزن عدّادات الحدود — مثيل منفصل بسياسة noeviction.
#
# الرئيسي يعمل بـ volatile-lru كي يبقى وسيط Celery حيًّا حين يمتلئ الكاش. لكن
# العدّاد المُخلى يُقرأ «صفر محاولات»: أي أن الإخلاء يمحو حدَّ الدخول وميزانية
# المدرسة وسقف فاتورة المساعد — صامتًا، ووقت الضغط تحديدًا.
#
# تركه فارغًا يُسقط العدّادات على الكاش المشترك: يعمل، لكن مع الفجوة أعلاه.
# وفي هذه الحالة اضبط LOGIN_THROTTLE_FAIL_CLOSED=False حتى لا يتحول إخلاءُ
# مفتاحٍ إلى منعِ دخولٍ للجميع.
REDIS_LIMITS_URL=redis://:replace-with-a-url-encoded-password@redis-limits:6379/0
REDIS_LIMITS_MAXMEMORY=96mb

# تعذُّر التحقق من عدّاد المحاولات يُعامل كـ«مقفل» لا كـ«مسموح».
# يتطلب REDIS_LIMITS_URL أعلاه. راجع SECURITY_AUDIT_REPORT.md — SEC-002.
LOGIN_THROTTLE_FAIL_CLOSED=True

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=https://nbg1.your-objectstorage.com
AWS_S3_REGION_NAME=nbg1
MEDIA_PUBLIC_ACCESS_ENABLED=False
AWS_QUERYSTRING_AUTH=True
# عمر الرابط الموقَّع بالثواني. الرابط يحمل التخويل في ذاته، فطولُ عمره هو
# طولُ نافذة التسريب. 900 = ربع ساعة (كان 86400 = يوم كامل).
AWS_QUERYSTRING_EXPIRE=900

WEB_CONCURRENCY=3
GUNICORN_TIMEOUT=120
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=800
GUNICORN_MAX_REQUESTS_JITTER=80
CELERY_CORE_CONCURRENCY=1
# اثنتان لا واحدة: عامل الوسائط يحمل الآن توليد PDF، وطلبٌ ينتظر خلف طلب
# آخر أبطأ مما كان عليه التصيير المتوازي على عامل الويب.
CELERY_MEDIA_CONCURRENCY=2
# MAX_CONCURRENT_REQUESTS=   # unset: derived from the budget below
OVERLOAD_RETRY_AFTER_SECONDS=5
SCHOOL_DASHBOARD_CACHE_TTL_SECONDS=45
SCHOOL_DASHBOARD_STALE_TTL_SECONDS=300
SCHOOL_DASHBOARD_LOCK_TTL_SECONDS=15
SCHOOL_RATE_LIMIT_ENABLED=True
SCHOOL_RATE_LIMIT_REQUESTS=900
SCHOOL_RATE_LIMIT_WINDOW_SECONDS=60
HEAVY_EXPORT_ASYNC_ENABLED=True
PDF_OFFLOAD_ENABLED=True
PDF_OFFLOAD_TIMEOUT_SECONDS=45
GENERATED_EXPORT_RETENTION_HOURS=6
INFRA_CAPACITY_MONITOR_ENABLED=True
REDIS_MEMORY_ALERT_PERCENT=80
CPU_ALERT_PERCENT=85
MEMORY_ALERT_PERCENT=85
DISK_ALERT_PERCENT=80
CELERY_QUEUE_ALERT_LENGTH=200
FCM_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
HTTP_5XX_ALERT_PERCENT=2.0
HTTP_LATENCY_ALERT_MS=2000
CONN_MAX_AGE=0
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
RUN_MIGRATIONS_ON_START=1
REDIS_MAXMEMORY_POLICY=volatile-lru
MANSOUR_ASSISTANT_DAILY_GLOBAL_LIMIT=2000
SESSION_CLEANUP_ENABLED=True
# سنة لا شهر: نزاعٌ تجاري أو تحقيقٌ أمني نادرًا ما يُكتشف خلال ثلاثين يومًا.
AUDIT_LOG_RETENTION_DAYS=365

# Email delivery is required for self-service password recovery.
EMAIL_BACKEND=reports.email_backends.ResendEmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=no-reply@tawtheeq-ksa.com
# Resend powers system email delivery and the platform mailbox. Store real
# values only in env.production.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_API_BASE_URL=https://api.resend.com
RESEND_TIMEOUT=15
RESEND_WEBHOOK_TOLERANCE=300
PASSWORD_CHANGE_EMAIL_ENABLED=True
SUBSCRIPTION_ACTIVATION_EMAIL_ENABLED=True
PASSWORD_RESET_TIMEOUT=3600
DAILY_MANAGER_REPORT_ENABLED=True
DAILY_MANAGER_REPORT_INAPP_ENABLED=True
DAILY_MANAGER_REPORT_HOUR=16
DAILY_MANAGER_REPORT_MINUTE=5
DAILY_MANAGER_REPORT_DAY_OF_WEEK=thu
SUBSCRIPTION_EXPIRY_REMINDER_ENABLED=True
SUBSCRIPTION_EXPIRY_REMINDER_DAYS=14,7,3,1
SUBSCRIPTION_EXPIRY_REMINDER_EMAIL_ENABLED=True

LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05
SECURITY_CONTACT_EMAIL=support@tawtheeq-ksa.com

# Operations mobile deployment control. Use a fine-grained GitHub token with
# read access to contents/actions and write access to actions for this repo.
OPERATIONS_GITHUB_REPOSITORY=xmansx2030-lgtm/school_reports
OPERATIONS_GITHUB_BRANCH=main
OPERATIONS_GITHUB_WORKFLOW=ci.yml
OPERATIONS_GITHUB_TOKEN=
OPERATIONS_DEPLOY_MONITOR_ENABLED=True

# Mansour AI assistant (store the real key only in the server .env)
OPENAI_API_KEY=
MANSOUR_ASSISTANT_ENABLED=True
MANSOUR_ASSISTANT_MODEL=gpt-5-mini
MANSOUR_ASSISTANT_QUALITY_MODE=True
MANSOUR_ASSISTANT_REASONING_EFFORT=low
MANSOUR_ASSISTANT_TEXT_VERBOSITY=medium
MANSOUR_ASSISTANT_MAX_OUTPUT_TOKENS=700
MANSOUR_ASSISTANT_TIMEOUT_SECONDS=20
REPORT_AI_ENABLED=True
REPORT_AI_MODEL=gpt-5-nano
REPORT_AI_MAX_OUTPUT_TOKENS=700
REPORT_AI_TIMEOUT_SECONDS=25
# إملاء التقرير صوتياً — ثلاث محاولات يومياً لكل معلم، داخل التطبيق المثبَّت.
VOICE_REPORT_ENABLED=True
VOICE_REPORT_MODEL=gpt-4o-mini-transcribe
VOICE_REPORT_DAILY_LIMIT=3
VOICE_REPORT_MAX_SECONDS=180
VOICE_REPORT_TIMEOUT_SECONDS=60
VOICE_REPORT_PWA_ONLY=True

# PDF rendering is offloaded to the media worker (queue: images) instead of
# burning CPU inside the web container. The request still waits for the same
# bytes, so nothing about the download changes.
#
# Set PDF_OFFLOAD_ENABLED=False to fall back to in-request rendering without a
# rebuild — the flag is read on every call, so a container restart is enough.
PDF_OFFLOAD_ENABLED=True
PDF_OFFLOAD_TIMEOUT_SECONDS=45

# Tamara: keep disabled until the production API and notification tokens are
# issued for Tawtheeq itself. Both values belong only in env.production (0600).
# Webhook: https://tawtheeq-ksa.com/payments/tamara/webhook/
TAMARA_ENABLED=False
TAMARA_ENVIRONMENT=production
TAMARA_API_TOKEN=
TAMARA_NOTIFICATION_TOKEN=
TAMARA_INSTALMENTS=4
TAMARA_REQUEST_TIMEOUT=15

# Moyasar: LIVE — this is the platform's active gateway.
#
# MOYASAR_SECRET_KEY must be the real sk_live_* key and belongs in this file on
# the server only (chmod 0600), never in Git. settings.py refuses to boot if the
# key prefix disagrees with MOYASAR_ENVIRONMENT, and strict production refuses
# test mode outright — so a stale test key fails the deploy instead of silently
# taking payments into a sandbox.
MOYASAR_ENABLED=True
MOYASAR_ENVIRONMENT=live
MOYASAR_SECRET_KEY=
MOYASAR_REQUEST_TIMEOUT=15

# تجربة التسجيل الذاتي للمدرسة
TRIAL_PLAN_NAME=التجربة المجانية
TRIAL_MAX_TEACHERS=5
TRIAL_ARCHIVE_STORAGE_GB=1

# Telegram operational alerts (store the real token only in the server .env)
TELEGRAM_ALERTS_ENABLED=False
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_ALERT_CATEGORIES=support,subscriptions,registration,payments,complaints
TELEGRAM_ALERT_TIMEOUT_SECONDS=10
TELEGRAM_ALERT_DEDUP_TTL_SECONDS=2592000
