PRODUCTION_STRICT_MODE=True
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12

# Required public business disclosure. Do not add a national ID or photo.
BUSINESS_LEGAL_NAME=
