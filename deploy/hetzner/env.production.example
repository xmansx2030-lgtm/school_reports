POSTGRES_DB=school_reports
POSTGRES_USER=school_reports
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://school_reports:replace-with-a-url-encoded-password@postgres:5432/school_reports
DB_SSL=False

REDIS_PASSWORD=replace-with-a-long-random-password
