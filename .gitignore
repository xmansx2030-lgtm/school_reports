# ---------------------------
# Django specifics
# ---------------------------
# قاعدة بيانات التطوير + أي نسخ محلية مؤقتة تنتجها أدوات التشغيل
db.sqlite3
*.sqlite3

# ملفات التجميع (collectstatic) محلياً
staticfiles/

# مرفوعات المستخدمين (لا تُرفع للمستودع)
media/
mediafiles/
tmp/

# ملفات البيئة والأسرار
.env
.env.*
*.env

# اسم مسموح لتتبع مثال إعدادات البيئة
!.env.example

# ---------------------------
# Migrations policy
# ---------------------------
# نسمح بتتبع ملفات الهجرات .py (ضروري للإنتاج)
# في حال كانت هناك قاعدة سابقة في .gitignore تمنع مجلد migrations،
# السطران التاليان يعيدان السماح بملفات الهجرات:
!*/migrations/*.py
!*/migrations/__init__.py

# لا نتتبع مخازن الترجمة داخل مجلد الهجرات
**/migrations/__pycache__/

# Local scratch scripts
*.tmp.py
.infra-temp/
operations_mobile/*.png
operations_mobile/*.xml

# Local browser/visual QA output. These can contain session profiles, screenshots,
# and machine-specific paths; reports belong in CI logs or release notes instead.
qa-artifacts/
.claude/skills/dark-mode-audit/scripts/mobile_sweep.cjs
# تقارير الاختبار اليدوي المحلية قد تتضمن حسابات تجريبية وبيانات جلسة.
tawtheeq-*-qa-report.md
qa-test-document.txt

# ---------------------------
# ملفات بيانات الدخول المحلية
# ---------------------------
# ملفات يكتب فيها المطوّر كلمات مرور الخوادم مؤقتاً. مكانها مدير كلمات مرور
# لا مجلد المشروع — لكن ما دامت هنا فلا يجوز أن يبتلعها `git add .`.
rot.md
credentials.md
creds.md
*credentials*.txt
*.pem
*.key
firebase-service-account.json
id_rsa*
id_ed25519*

